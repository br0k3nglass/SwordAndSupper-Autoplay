// Create a single, realistic browser UA string
const USER_AGENT = `Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/${
  120 + Math.floor(Math.random() * 30)
}.0.${Math.floor(Math.random() * 5000)}.100 Safari/537.36`;

// Function to fetch Reddit JSON using browser-like headers
async function redditFetch(url) {
  const res = await fetch(url, {
    headers: {
      "User-Agent": USER_AGENT,
      "Accept": "application/json, text/javascript, */*; q=0.01",
      "Accept-Language": "en-US,en;q=0.9",
      "Referer": `https://www.reddit.com/r/${SUBREDDIT}/`,
      "Sec-Fetch-Dest": "empty",
      "Sec-Fetch-Mode": "cors",
      "Sec-Fetch-Site": "same-origin"
    }
  });
  return res;
}


