// ----------------- Helper Functions -----------------
function loadVisited() {
  try {
    const data = fs.readFileSync(VISITED_FILE, "utf8");
    return new Set(JSON.parse(data));
  } catch {
    return new Set();
  }
}

function saveVisited(visitedSet) {
  fs.writeFileSync(VISITED_FILE, JSON.stringify([...visitedSet], null, 2));
}

const visited = loadVisited();

// Fetch newest posts from Reddit API
async function getPostUrls() {
  let results = [];
  let after = null;

  while (results.length < MAX_COUNT) {
    const apiUrl = new URL(`https://www.reddit.com/r/${SUBREDDIT}/search.json`);
    apiUrl.searchParams.set("q", `flair:"${FLAIR}"`);
    apiUrl.searchParams.set("restrict_sr", "on");
    apiUrl.searchParams.set("sort", "new");
    apiUrl.searchParams.set("limit", PAGE_SIZE.toString());
    if (after) apiUrl.searchParams.set("after", after);

    console.log(`Fetching: ${apiUrl.href}`);
    //const response = await fetch(apiUrl.href);
	  const response = await redditFetch(apiUrl.href);

    if (!response.ok) throw new Error(`Failed to fetch posts: ${response.status}`);

    const json = await response.json();
    const batch = json.data.children;

    if (batch.length === 0) break;

    for (const post of batch) {
      const id = post.data.id;
      if (!visited.has(id)) {
        results.push({
          id,
          url: `https://reddit.com${post.data.permalink}`,
        });
      }
    }

    after = json.data.after;
    if (!after) break;
  }

  return results.slice(0, MAX_COUNT);
}

// --- attempt to get the top leftmost coordinates of the second monitor
function getSecondaryMonitorTopLeft() {
  try {
    const output = execSync("xrandr --query").toString();

    // Parse all connected monitors
    const monitors = output
      .split("\n")
      .filter(line => line.includes(" connected "))
      .map(line => {
        const primary = line.includes(" primary");
        const match = line.match(/\+(\d+)\+(\d+)/); // +X+Y
        if (match) {
          return {
            x: parseInt(match[1], 10),
            y: parseInt(match[2], 10),
            primary
          };
        }
        return null;
      })
      .filter(Boolean);

    // Find the first non-primary monitor
    const secondary = monitors.find(m => !m.primary);
    if (!secondary) {
      console.warn("No secondary monitor detected. Using primary monitor.");
      return { x: 0, y: 0 };
    }

    return { x: secondary.x, y: secondary.y };
  } catch (err) {
    console.error("Error detecting monitors:", err);
    return { x: 0, y: 0 };
  }
}

// --- Optimized Shadow DOM Button Finder ---
async function findMissionButton(page) {
  // Run inside page context
  const elements = await page.evaluateHandle(() => {
    function findInShadowRoots(root) {
      const results = [];
      function traverse(node) {
        if (!node) return;

        // If this is a clickable mission div
        if (
          node.nodeType === 1 &&
          node.classList?.contains('box-border') &&
          node.classList?.contains('cursor-pointer')
        ) {
          results.push(node);
        }

        // Dive into shadow DOM
        if (node.shadowRoot) {
          node.shadowRoot.querySelectorAll('*').forEach(traverse);
        }

        // Dive into light DOM
        if (node.children) {
          for (const child of node.children) traverse(child);
        }
      }

      traverse(root);
      return results;
    }

    return findInShadowRoots(document.body);
  });

  // Convert NodeList handles into actual element handles
  const properties = await elements.getProperties();

  for (const property of properties.values()) {
    const elHandle = property.asElement();
    if (!elHandle) continue;

    const style = await elHandle.evaluate(node => node.getAttribute('style') || '');
    if (style.includes('3kg6d3isvyre1.png')) {
      return { type: 'START_MISSION', element: elHandle };
    }
    if (style.includes('fxlui9egtgbf1.png')) {
      return { type: 'GO_TO_INN', element: elHandle };
    }
  }

  return null;
}

